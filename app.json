{
  "expo": {
    "name": "Bazario",
    "slug": "bazario-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5C67F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bazario.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C67F2"
      },
      "package": "com.bazario.shop"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bazario",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Adonik to access your location to provide accurate delivery options and detect your address."
        }
      ]
    ]
  }
}
